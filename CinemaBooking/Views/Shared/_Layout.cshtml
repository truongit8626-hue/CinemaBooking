<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinemaBooking</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar-pro">
        <div class="nav-left">

            <div class="logo">
                🎬 <span class="logo-text">CGV HTTC</span>
            </div>

            <div class="menu">
                <a href="/Movie/Index">Phim</a>
                <a href="/Booking/History" class="hide-mobile">📜 Lịch sử</a>
                <a href="/Booking/MyTickets" class="ticket-btn">🎟 Vé của tôi</a>
            </div>

        </div>

        <div class="nav-right">

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                @if (User.IsInRole("Admin"))
                {
                    <a href="/Admin" class="admin-btn">
                        ⚙ Quản lý phim
                    </a>

                    <a href="/Admin/Dashboard" class="admin-btn">
                        📊 Dashboard
                    </a>
                }

                <span class="user-info">
                    👤 @User.Identity.Name
                </span>

                <form method="post"
                      asp-area="Identity"
                      asp-page="/Account/Logout"
                      style="display:inline;">
                    <button type="submit" class="btn btn-danger">
                        Logout
                    </button>
                </form>
            }
            else
            {
                <a href="/Identity/Account/Login"
                   class="btn btn-warning">
                    Login
                </a>
            }

        </div>
    </nav>

    <!-- CONTENT -->
    <div>
        @RenderBody()
    </div>

    <!-- AI ASSISTANT BAR -->
    <div class="ai-bar">

        <button type="button"
                class="ai-toggle"
                onclick="toggleAIBar()"
                title="Mở Trợ lý AI CinemaBooking"
                aria-label="Mở Trợ lý AI CinemaBooking">
            🤖
        </button>

        <div class="ai-menu"
             id="aiMenu">

            <div class="ai-header">
                <div class="ai-title">
                    🤖 Trợ lý AI CinemaBooking
                </div>

                <div class="ai-subtitle">
                    Hỗ trợ phim, suất chiếu và phân tích dữ liệu
                </div>
            </div>

            <a href="/Movie/Recommendations"
               class="ai-item">

                <div class="ai-icon">
                    🎬
                </div>

                <div class="ai-item-content">
                    <div class="ai-item-title">
                        Gợi ý phim cho bạn
                    </div>

                    <div class="ai-item-description">
                        Đề xuất dựa trên sở thích và lịch sử đặt vé
                    </div>
                </div>
            </a>

            <a href="/AIChat/Index"
               class="ai-item">

                <div class="ai-icon">
                    💬
                </div>

                <div class="ai-item-content">
                    <div class="ai-item-title">
                        Hỏi trợ lý AI
                    </div>

                    <div class="ai-item-description">
                        Hỏi về phim và suất chiếu trong hệ thống
                    </div>
                </div>
            </a>

            @if (User.Identity != null
                && User.Identity.IsAuthenticated
                && User.IsInRole("Admin"))
            {
                <a href="/AIForecast/Index"
                   class="ai-item ai-admin-item">

                    <div class="ai-icon">
                        📊
                    </div>

                    <div class="ai-item-content">
                        <div class="ai-item-title">
                            Dự báo kinh doanh
                        </div>

                        <div class="ai-item-description">
                            Phân tích vé, doanh thu và tỷ lệ lấp đầy
                        </div>

                        <span class="ai-admin-badge">
                            Admin
                        </span>
                    </div>
                </a>
            }

            <div class="ai-footer-note">
                ⚠️ Kết quả AI chỉ mang tính hỗ trợ và tham khảo.
            </div>

        </div>
    </div>

    <!-- FOOTER -->
    <footer style="display:none;">
        <hr />
        <p>© 2026 - Cinema Booking System</p>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        function toggleAIBar() {
            const menu = document.getElementById("aiMenu");
            menu.classList.toggle("show");
        }

        document.addEventListener("click", function (event) {

            const aiBar = document.querySelector(".ai-bar");
            const aiMenu = document.getElementById("aiMenu");

            if (!aiBar || !aiMenu) {
                return;
            }

            if (!aiBar.contains(event.target)) {
                aiMenu.classList.remove("show");
            }
        });
    </script>

    @RenderSection("Scripts", required: false)

    <style>

        /* =========================
           AI ASSISTANT BAR
           ========================= */

        .ai-bar {
            position: fixed;
            right: 20px;
            bottom: 30px;
            z-index: 9999;
            font-family: Arial, sans-serif;
        }

        .ai-toggle {
            width: 58px;
            height: 58px;
            border: none;
            border-radius: 50%;
            background: #ffc107;
            color: #222;
            font-size: 27px;
            cursor: pointer;
            box-shadow: 0 5px 18px rgba(0,0,0,0.3);
            transition: 0.2s;
        }

        .ai-toggle:hover {
            transform: scale(1.07);
        }

        .ai-menu {
            display: none;
            width: 310px;
            margin-bottom: 12px;
            background: #ffffff;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(0,0,0,0.3);
            border: 1px solid #e5e5e5;
        }

        .ai-menu.show {
            display: block;
        }

        .ai-header {
            padding: 15px 16px;
            background: #212529;
            color: white;
        }

        .ai-title {
            font-weight: bold;
            font-size: 16px;
        }

        .ai-subtitle {
            margin-top: 4px;
            font-size: 12px;
            color: #ced4da;
            line-height: 1.4;
        }

        .ai-item {
            display: flex;
            gap: 12px;
            padding: 14px 16px;
            color: #212529 !important;
            background: #ffffff !important;
            text-decoration: none !important;
            border-bottom: 1px solid #eeeeee;
            transition: 0.2s;
        }

        .ai-item:hover {
            background: #f8f9fa !important;
            color: #000 !important;
        }

        .ai-icon {
            min-width: 34px;
            font-size: 23px;
            display: flex;
            align-items: flex-start;
            justify-content: center;
        }

        .ai-item-content {
            flex: 1;
            min-width: 0;
        }

        .ai-item-title {
            font-size: 14px;
            font-weight: 700;
            color: #212529;
        }

        .ai-item-description {
            margin-top: 3px;
            font-size: 12px;
            line-height: 1.4;
            color: #6c757d;
        }

        .ai-admin-item {
            position: relative;
        }

        .ai-admin-badge {
            display: inline-block;
            margin-top: 6px;
            padding: 2px 7px;
            border-radius: 10px;
            background: #212529;
            color: white;
            font-size: 10px;
            font-weight: bold;
        }

        .ai-footer-note {
            padding: 11px 14px;
            background: #fff3cd;
            color: #664d03;
            font-size: 11px;
            line-height: 1.4;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .menu {
            display: flex;
            gap: 15px;
        }

        @@media (max-width: 576px) {

            .ai-bar {
                right: 12px;
                bottom: 18px;
            }

            .ai-menu {
                width: calc(100vw - 40px);
                max-width: 310px;
            }

            .ai-toggle {
                width: 52px;
                height: 52px;
                font-size: 24px;
            }
        }

    </style>

</body>
</html>