@model List<CinemaBooking.ViewModels.TicketViewModel>

<div class="ticket-list">
    <h2>🎟 Vé của tôi</h2>
    @if (!Model.Any())
{
    <p style="color: gray;">Bạn chưa có vé nào sắp chiếu 🎬</p>
}

    @foreach (var t in Model)
{
    <div class="ticket-card">

        <!-- BUTTON -->
        <div class="ticket-left">
            <a asp-action="TicketDetail"
               asp-route-id="@t.BookingId"
               class="btn-detail">
                🔍 Xem chi tiết
            </a>
        </div>

        <!-- QR -->
        <div class="ticket-qr">
            <img src="@t.QRCode" />
        </div>

        <!-- INFO -->
        <div class="ticket-info">
            <h4>@t.MovieName</h4>

            <p>⏰ @t.Showtime</p>
            <p>🎟 Ghế: @t.Seats</p>
            <p class="price">💰 @t.Total VND</p>
        </div>

    </div>
}
</div>
    }
</div>

<style>
    .ticket-list {
        padding: 40px;
        color: white;
    }
    .ticket-card {
    display: flex;
    align-items: center;
    gap: 25px;

    background: rgba(20,20,20,0.95);
    border-radius: 20px;
    padding: 20px 30px;

    margin-bottom: 20px;

    box-shadow: 0 10px 40px rgba(0,0,0,0.6);
    border: 1px solid rgba(255,193,7,0.2);

    transition: 0.3s;
}

.ticket-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 50px rgba(255,193,7,0.3);
}

/* BUTTON */
.ticket-left {
    min-width: 140px;
}

.btn-detail {
    display: flex;
    justify-content: center;
    align-items: center;

    padding: 15px;
    border-radius: 15px;

    font-weight: 600;
    text-decoration: none;

    color: white;
    background: linear-gradient(135deg, #2196f3, #00bcd4);

    transition: 0.3s;
}

.btn-detail:hover {
    transform: scale(1.05);
    box-shadow: 0 5px 20px rgba(33,150,243,0.6);
}

/* QR */
.ticket-qr img {
    width: 90px;
    height: 90px;
    border-radius: 10px;
    background: white;
    padding: 5px;
}

/* INFO */
.ticket-info h4 {
    color: #ffc107;
    font-size: 22px;
    margin-bottom: 10px;
}

.ticket-info p {
    margin: 3px 0;
    color: #ccc;
}

.price {
    margin-top: 8px;
    color: #4caf50;
    font-weight: bold;
}

   
</style>