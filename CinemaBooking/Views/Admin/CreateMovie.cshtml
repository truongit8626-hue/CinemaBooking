@model CinemaBooking.Models.Movie
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<div class="form-container">

    <h2>🎬 Thêm phim</h2>

    <form asp-action="CreateMovie" method="post" enctype="multipart/form-data">

        <div class="form-group">
            <label>Tên phim</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Thể loại</label>
            <input asp-for="Genre" class="form-control" />
            <span asp-validation-for="Genre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Thời lượng</label>
            <input asp-for="Duration" class="form-control" />
            <span asp-validation-for="Duration" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Mô tả</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Ảnh Poster</label>
            <input type="file" name="posterFile" class="form-control" />
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn-submit">
                🎬 Thêm phim 
            </button>
        </div>

    </form>

</div>
<style>
    .btn-submit {
        padding: 14px 40px;
        font-size: 18px;
        font-weight: 600;
        border: none;
        border-radius: 30px;
        color: black;
        background: linear-gradient(45deg, #ffc107, #ff9800);
        box-shadow: 0 5px 15px rgba(255, 193, 7, 0.4);
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-submit:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 10px 25px rgba(255, 193, 7, 0.6);
        }

        .btn-submit:active {
            transform: scale(0.95);
        }
</style>